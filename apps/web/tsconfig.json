{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@app/types": ["../../libs/types/src/index.ts"],
      "@app/ui": ["../../libs/ui/src/index.ts"],
      "@app/config": ["../../libs/config/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
