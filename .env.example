# ─── Database ───────────────────────────────────────────────
# Opción A — Docker (recomendado, ver docker-compose.yml)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Opción B — PostgreSQL local instalado en la máquina
# DATABASE_URL="postgresql://<tu-usuario>:<tu-password>@localhost:5432/<nombre-db>?schema=public"

DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<db>?schema=public"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ─── API (NestJS) ────────────────────────────────────────────
PORT=3001

# ─── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
